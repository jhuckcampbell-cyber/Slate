# Copy to supabase/functions/.env for local dev (gitignored). In prod: npx supabase secrets set ...
ODDS_PROVIDER=fake                      # 'fake' (no credits) | 'the-odds-api'
ODDS_SYNC_SECRET=local-dev-sync-secret  # must match the Vault secret 'odds_sync_secret'
ODDS_BOOKMAKERS=draftkings,fanduel,betmgm
# ODDS_API_KEY=                         # required when ODDS_PROVIDER=the-odds-api
