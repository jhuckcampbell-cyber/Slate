# Copy to .env.local. Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Cloudflare Turnstile public site key. Leave unset for local dev/e2e.
# Configure the matching secret in Supabase Auth CAPTCHA settings, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Edge Function secrets (set via `npx supabase secrets set` in prod; supabase/functions/.env locally)
# ODDS_API_KEY=
# ODDS_PRIMARY_BOOK=draftkings
# ODDS_SYNC_DRY_RUN=1
